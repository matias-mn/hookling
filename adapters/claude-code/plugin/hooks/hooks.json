{
  "description": "Tell the Hookling desktop pet what Claude Code is doing.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"${CLAUDE_PLUGIN_ROOT}/bin/hookling-hook\"; [ -x \"$h\" ] || h=\"$HOME/Library/Application Support/Hookling/bin/hookling-hook\"; [ -x \"$h\" ] && exec \"$h\" session_started; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"${CLAUDE_PLUGIN_ROOT}/bin/hookling-hook\"; [ -x \"$h\" ] || h=\"$HOME/Library/Application Support/Hookling/bin/hookling-hook\"; [ -x \"$h\" ] && exec \"$h\" prompt_submitted; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"${CLAUDE_PLUGIN_ROOT}/bin/hookling-hook\"; [ -x \"$h\" ] || h=\"$HOME/Library/Application Support/Hookling/bin/hookling-hook\"; [ -x \"$h\" ] && exec \"$h\" work_started; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"${CLAUDE_PLUGIN_ROOT}/bin/hookling-hook\"; [ -x \"$h\" ] || h=\"$HOME/Library/Application Support/Hookling/bin/hookling-hook\"; [ -x \"$h\" ] && exec \"$h\" work_progress; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"${CLAUDE_PLUGIN_ROOT}/bin/hookling-hook\"; [ -x \"$h\" ] || h=\"$HOME/Library/Application Support/Hookling/bin/hookling-hook\"; [ -x \"$h\" ] && exec \"$h\" attention_needed; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"${CLAUDE_PLUGIN_ROOT}/bin/hookling-hook\"; [ -x \"$h\" ] || h=\"$HOME/Library/Application Support/Hookling/bin/hookling-hook\"; [ -x \"$h\" ] && exec \"$h\" work_progress; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"${CLAUDE_PLUGIN_ROOT}/bin/hookling-hook\"; [ -x \"$h\" ] || h=\"$HOME/Library/Application Support/Hookling/bin/hookling-hook\"; [ -x \"$h\" ] && exec \"$h\" work_finished; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"${CLAUDE_PLUGIN_ROOT}/bin/hookling-hook\"; [ -x \"$h\" ] || h=\"$HOME/Library/Application Support/Hookling/bin/hookling-hook\"; [ -x \"$h\" ] && exec \"$h\" session_ended; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
